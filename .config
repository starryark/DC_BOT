# --- DC voice bot config (added 2026-07-30) ---
CONVERSATION_MAX_MESSAGES=24
# Local Gemini limiter + cooldown. Budget is deliberately slack: the account has
# quota headroom, so these exist to avoid hammering upstream on a fault, not to
# ration requests. NOTICE: parseBounded silently returns its fallback for any
# out-of-range value, so 0 here does NOT mean "unlimited" -- it means 4.
GEMINI_REQUESTS_PER_MINUTE=1000
# Serialized generation was the throughput cap once the per-minute budget was
# lifted: a voice turn and a text turn in the same room could not generate
# concurrently. Max accepted is 32.
GEMINI_MAX_CONCURRENT_REQUESTS=8
# A single 429 blocks *every* subsequent acquisition until it expires, so a full
# minute of dead air was too punitive for a transient burst.
GEMINI_DEFAULT_COOLDOWN_MS=5000
GEMINI_COOLDOWN_PROMPT_INTERVAL_MS=60000
# Thinking tokens are billed against maxOutputTokens on Gemini 3.x, so these
# ceilings must cover reasoning AND the answer. At the previous defaults (256 /
# 384 / 768) a prompt asking for detail raised thinking effort, reasoning
# consumed the whole budget, and the visible reply was truncated to a couple of
# characters -- silently, because a truncated reply is indistinguishable from a
# short one at the pipeline boundary. Severity ran opposite to intent: the more
# detail a user asked for, the emptier the answer.
GEMINI_MAX_OUTPUT_TOKENS_CASUAL=1024
GEMINI_MAX_OUTPUT_TOKENS_STANDARD=4096
GEMINI_MAX_OUTPUT_TOKENS_DETAILED=8192
# Persona: the registry reads <CHARACTER_PATH>/<CHARACTER_ID>/card.json, so the
# path is the directory CONTAINING character folders. Relative to this directory
# (discord_bot project root). Empty CHARACTER_PATH = no persona.
CHARACTER_PATH=./characters
CHARACTER_ID=Makise Kurisu
# TTS (GPT-SoVITS Kurisu on :9880)
GPT_SOVITS_URL=http://127.0.0.1:9880
GPT_SOVITS_REQUEST_TIMEOUT_MS=30000
GPT_SOVITS_REF_AUDIO=../TTS-KurisuMakise\WAV\crs_0127.WAV_0000000000_0000164160.wav
GPT_SOVITS_PROMPT_TEXT=そうです。私が死んだのを見たっていうのが事実なのか。
# PROMPT_LANG = language of the Kurisu reference clip (always ja). This defines
# the voice identity, NOT the language being spoken. Do not change it per turn.
GPT_SOVITS_PROMPT_LANG=ja
# Fallback text_lang when ASR language + text evidence are both unavailable.
# 'auto' lets GPT-SoVITS detect per segment. Fallback only — does not disable
# dynamic per-turn routing.
GPT_SOVITS_TEXT_LANG=auto
GPT_SOVITS_STREAMING_MODE=0
GPT_SOVITS_VOICE_MODEL_VERSION=kurisu-local-v1
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=.cache/tts
TTS_CACHE_MAX_MB=512
TTS_CACHE_MAX_ITEMS=1000
TTS_CACHE_TTL_HOURS=168
TTS_CACHE_MEMORY_ITEMS=256

# Language-aware response chunking and bounded one-chunk TTS lookahead.
TTS_CHUNK_MIN_LATIN_CHARS=40
TTS_CHUNK_TARGET_LATIN_CHARS=55
TTS_CHUNK_MAX_LATIN_CHARS=120
TTS_CHUNK_MIN_CJK_CHARS=14
TTS_CHUNK_TARGET_CJK_CHARS=28
TTS_CHUNK_MAX_CJK_CHARS=50
# Only the opening chunk's synthesis is heard as silence — every later chunk is
# synthesized while its predecessor plays — so it is sized separately. A CJK
# character is ~200ms of speech at ~100ms of synthesis, so each character held
# back from the opening is ~100ms before the character starts speaking.
TTS_CHUNK_OPENING_MIN_LATIN_CHARS=24
TTS_CHUNK_OPENING_TARGET_LATIN_CHARS=48
TTS_CHUNK_OPENING_MAX_LATIN_CHARS=72
TTS_CHUNK_OPENING_MIN_CJK_CHARS=8
TTS_CHUNK_OPENING_TARGET_CJK_CHARS=16
TTS_CHUNK_OPENING_MAX_CJK_CHARS=32
# Time the floor waits after an utterance ends before dispatching, to merge
# other speakers into one turn (`flushAt = endedAt + groupWindowMs`). It is
# additive to VOICE_END_SILENCE_MS on every turn, and merging buys little in a
# small private room, so it is kept short.
VOICE_GROUP_WINDOW_MS=300
VOICE_ACTIVE_SPEAKER_LEASE_MS=5000
VOICE_MAX_GROUP_SPEAKERS=2
VOICE_MAX_GROUP_UTTERANCES=4
BOT_BACKEND=direct
# Conversation policy. half_duplex drops speech that arrives while the bot is
# thinking or speaking, before ASR; barge_in admits it and lets the controller
# cancel the turn in flight. See docs/voice-optimization/.
#
# barge_in is only half of talk-over interruption: it decides what happens once
# a barge-in is reported, while BARGE_IN_ENABLED below decides whether the
# acoustic detector reports one at all. Both are required — with either alone
# the character speaks over you.
BOT_INPUT_POLICY=half_duplex
# Voice endpointing (900ms end-silence so mid-sentence pauses stop finalizing
# one-word fragments).
VOICE_END_SILENCE_MS=900
VOICE_MIN_UTTERANCE_MS=300
VOICE_MAX_UTTERANCE_MS=30000
VOICE_DUPLICATE_WINDOW_MS=3000
BARGE_IN_WINDOW_FRAMES=30
# Average amplitude that counts as a real speaker. The detector has hysteresis
# — it triggers above this and only re-arms below half of it — so the value
# trades false interruptions against a slow stop. It is UNTUNED for this room;
# raise it if the character cuts itself off, lower it if talking over it is
# ignored.
BARGE_IN_THRESHOLD=0.05
# NOTICE: requires headphones, or something close to them.
#
# The detector listens to the same voice channel the character is speaking into.
# An open microphone near loudspeakers feeds the character's own audio back in,
# which reads as a sustained speaker above threshold and interrupts every reply
# almost as soon as it starts. Nothing in the pipeline can distinguish that from
# a person, because acoustically it is not different.
#
# Historically off by default (D-V06): a single loud packet stopped audible
# audio while generation and synthesis carried on regardless
# (`baseline-findings.md` §4). That is addressed — the detector now uses
# hysteresis and the controller cancels the whole turn, not just playback — but
# the feedback constraint above is physical and remains.
BARGE_IN_ENABLED=false
DEBUG_DUMP_AUDIO=false
# ASR (Qwen3-ASR service)
ASR_BASE_URL=http://127.0.0.1:8765
ASR_REQUEST_TIMEOUT_MS=15000
