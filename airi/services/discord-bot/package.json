{
  "name": "@proj-airi/discord-bot",
  "type": "module",
  "private": true,
  "description": "Discord bot for AIRI",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moeru-ai/airi.git",
    "directory": "services/discord-bot"
  },
  "scripts": {
    "start": "tsx --env-file=.env --env-file-if-exists=.config --env-file-if-exists=.env.local src/index.ts",
    "benchmark:voice": "tsx scripts/benchmark-voice.ts",
    "memory:status": "tsx scripts/memory/index.ts status",
    "memory:inspect": "tsx scripts/memory/index.ts inspect",
    "memory:integrity": "tsx scripts/memory/index.ts integrity",
    "memory:backup": "tsx scripts/memory/index.ts backup",
    "memory:restore": "tsx scripts/memory/index.ts restore",
    "memory:reconcile-bindings": "tsx scripts/memory/index.ts reconcile-bindings",
    "memory:reconcile-deliveries": "tsx scripts/memory/index.ts reconcile-deliveries",
    "memory:verify-deletion": "tsx scripts/memory/index.ts verify-deletion",
    "memory:smoke": "tsx scripts/memory/index.ts smoke",
    "memory:active-soak": "tsx scripts/memory/active-soak.ts",
    "memory:evaluate": "tsx scripts/memory/evaluate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "catalog:",
    "@google/genai": "catalog:",
    "@guiiai/logg": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@proj-airi/audio": "workspace:^",
    "@proj-airi/discord-avatar-protocol": "workspace:^",
    "@proj-airi/memory-domain": "workspace:*",
    "@proj-airi/memory-sqlite": "workspace:*",
    "@proj-airi/server-sdk": "workspace:^",
    "@proj-airi/server-shared": "workspace:^",
    "@snazzah/davey": "catalog:",
    "@xsai-ext/providers": "catalog:",
    "@xsai/generate-speech": "catalog:",
    "@xsai/generate-text": "catalog:",
    "@xsai/generate-transcription": "catalog:",
    "@xsai/shared-chat": "catalog:",
    "discord.js": "catalog:",
    "libsodium-wrappers": "catalog:",
    "opusscript": "catalog:",
    "tsx": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:vitest",
    "wavefile": "catalog:"
  }
}
