# ─────────────────────────────────────────────────────────────────────────
# Discord Voice Bot — example environment
# Copy to `.env` and fill in real values. NEVER commit real tokens.
# Loaded by the `start` script via `tsx --env-file=.env`.
# ─────────────────────────────────────────────────────────────────────────

# Discord
DISCORD_TOKEN=
DISCORD_BOT_CLIENT_ID=

# Runtime backend:
#   direct  → Qwen ASR → Gemini → GPT-SoVITS, all orchestrated in this process.
#   airi    → defer to the AIRI WebSocket server (legacy / optional).
BOT_BACKEND=direct

# ── Conversation policy ───────────────────────────────────────────────────
# How speech arriving while the bot is already working is treated:
#   half_duplex  (default) drop it before ASR; never backlogged.
#   latest_wins  keep at most one waiting turn, replaced by the newest.
#   barge_in     busy-state speech cancels the active response.
BOT_INPUT_POLICY=half_duplex

# ── Voice endpointing (see plan.md §14) ───────────────────────────────────
# Trailing silence after which a user's utterance is finalized. 900ms (was 650)
# so a natural mid-sentence pause no longer finalizes a fragment.
VOICE_END_SILENCE_MS=900
# Utterances shorter than this are discarded as noise.
VOICE_MIN_UTTERANCE_MS=300
# Hard cap on a single utterance length (ms).
VOICE_MAX_UTTERANCE_MS=30000
# Reject an identical transcript from the SAME user inside this window.
# Never applied across users.
VOICE_DUPLICATE_WINDOW_MS=3000
# Barge-in detection window (20ms PCM frames) and amplitude threshold (0..1).
BARGE_IN_WINDOW_FRAMES=30
BARGE_IN_THRESHOLD=0.05
# Amplitude-triggered barge-in. Disabled by default: a single loud packet used
# to stop audible audio while generation and synthesis carried on regardless.
# Under half-duplex, busy-state speech is dropped at admission instead.
BARGE_IN_ENABLED=false
# Dump each finalized utterance to ./dumps/*.wav for manual inspection.
DEBUG_DUMP_AUDIO=false

# ── ASR (Qwen3-ASR service) ───────────────────────────────────────────────
ASR_BASE_URL=http://127.0.0.1:8765
ASR_REQUEST_TIMEOUT_MS=15000

# ── Brain (Gemini) ────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CONVERSATION_MAX_MESSAGES=24
# Local request limiter, kept BELOW the account quota so excess turns wait
# instead of burning requests on a guaranteed 429.
GEMINI_REQUESTS_PER_MINUTE=4
GEMINI_MAX_CONCURRENT_REQUESTS=1
# Cooldown applied when a 429 carries no parseable retryDelay.
GEMINI_DEFAULT_COOLDOWN_MS=60000
# Minimum gap between spoken "temporarily unable to answer" notices.
GEMINI_COOLDOWN_PROMPT_INTERVAL_MS=60000

# ── Character card (chara_card_v3) ────────────────────────────────────────
# The registry reads <CHARACTER_PATH>/<CHARACTER_ID>/card.json, so the path is
# the directory CONTAINING character folders, not the card itself. It is
# relative to THIS directory (airi/services/discord-bot).
# The card's description / personality / scenario / system_prompt /
# post_history_instructions become the system instruction, preceded by delivery
# rules (output language, TTS-safe text) that take precedence on conflict.
# Set CHARACTER_PATH empty to run without a persona. Applied at restart.
CHARACTER_PATH=../../..
CHARACTER_ID=Makise Kurisu

# ── TTS (GPT-SoVITS api_v2.py :9880, Kurisu Makise voice) ─────────────────
GPT_SOVITS_URL=http://127.0.0.1:9880
GPT_SOVITS_REQUEST_TIMEOUT_MS=30000
# Reference audio clip + its transcript/language. These condition the loaded
# trained Kurisu weights on every request. Path is relative to the GPT-SoVITS
# WORKING DIRECTORY (the folder you run `python api_v2.py` from), since
# api_v2.py resolves ref_audio_path server-side. With DC_BOT/GPT-SoVITS as the
# CWD, the Kurisu clips are at ../TTS-KurisuMakise/.
GPT_SOVITS_REF_AUDIO=../TTS-KurisuMakise/害羞示范.wav
GPT_SOVITS_PROMPT_TEXT=
# PROMPT_LANG = language of the Kurisu *reference clip* (always ja). Do NOT
# change this to the user's language — it defines the voice identity, not the
# language being spoken. The synthesized target language is resolved per turn
# (see GPT_SOVITS_TEXT_LANG) and sent as `text_lang`, independent of this value.
GPT_SOVITS_PROMPT_LANG=ja
# Fallback `text_lang` when neither the ASR-detected language nor strong text
# evidence is available. `auto` lets GPT-SoVITS' LangSegmenter detect the
# language per segment (recommended for mixed-language replies). This is a
# fallback only — it does not disable dynamic per-turn routing.
GPT_SOVITS_TEXT_LANG=auto
# 0 = whole synthesis (correctness first); benchmark 1/2/3 later.
GPT_SOVITS_STREAMING_MODE=0
# Bump whenever the loaded GPT/SoVITS weights or synthesis defaults change.
# Empty is safe and disables caching because the voice identity is unknown.
GPT_SOVITS_VOICE_MODEL_VERSION=kurisu-local-v1
# Empty selects explicit single-reference mode using the three settings above.
# Otherwise copy config/gpt-sovits-voice-profiles.example.json and set its path.
GPT_SOVITS_VOICE_PROFILES_FILE=
# Maximum ACT-v1 DELAY applied before the following spoken chunk.
GPT_SOVITS_MAX_MODEL_PAUSE_MS=350
# Warm the default and profiles marked `warmup` when catalog mode starts.
GPT_SOVITS_WARMUP_ENABLED=true

# Versioned two-tier TTS cache (memory LRU, then atomic disk entries).
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=.cache/tts
TTS_CACHE_MAX_MB=512
TTS_CACHE_MAX_ITEMS=1000
TTS_CACHE_TTL_HOURS=168
TTS_CACHE_MEMORY_ITEMS=32

# Language-aware response chunking and the bounded TTS lookahead (Wave 3A).
TTS_CHUNK_MIN_LATIN_CHARS=40
TTS_CHUNK_TARGET_LATIN_CHARS=75
TTS_CHUNK_MAX_LATIN_CHARS=120
TTS_CHUNK_MIN_CJK_CHARS=14
TTS_CHUNK_TARGET_CJK_CHARS=28
TTS_CHUNK_MAX_CJK_CHARS=50
TTS_CHUNK_MAX_WAIT_MS=900
TTS_PREFETCH_CHUNKS=1

# Multi-speaker conversation floor (Wave 3C).
VOICE_GROUP_WINDOW_MS=800
VOICE_ACTIVE_SPEAKER_LEASE_MS=5000
VOICE_MAX_GROUP_SPEAKERS=2
VOICE_MAX_GROUP_UTTERANCES=4

# ── Legacy / optional AIRI server (BOT_BACKEND=airi) ──────────────────────
AIRI_URL=ws://localhost:6121/ws
AIRI_TOKEN=abcd
AVATAR_ENABLED=false
AVATAR_RELAY_URL=ws://127.0.0.1:8080/ws/publisher
AVATAR_RELAY_PUBLISH_TOKEN=
AVATAR_DEBUG_COMMAND_ENABLED=false
