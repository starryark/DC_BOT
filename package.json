{
  "name": "discord_bot",
  "type": "module",
  "private": true,
  "description": "Standalone Discord voice bot with external local voice services",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File start-bot.ps1",
    "start:bot": "tsx --env-file=.env --env-file-if-exists=.config --env-file-if-exists=.env.local src/index.ts",
    "runtime:check": "tsx --env-file=.env --env-file-if-exists=.config --env-file-if-exists=.env.local scripts/runtime-check.ts",
    "benchmark:voice": "tsx scripts/benchmark-voice.ts",
    "memory:status": "tsx scripts/memory/index.ts status",
    "memory:inspect": "tsx scripts/memory/index.ts inspect",
    "memory:integrity": "tsx scripts/memory/index.ts integrity",
    "memory:backup": "tsx scripts/memory/index.ts backup",
    "memory:restore": "tsx scripts/memory/index.ts restore",
    "memory:reconcile-bindings": "tsx scripts/memory/index.ts reconcile-bindings",
    "memory:reconcile-deliveries": "tsx scripts/memory/index.ts reconcile-deliveries",
    "memory:verify-deletion": "tsx scripts/memory/index.ts verify-deletion",
    "memory:smoke": "tsx scripts/memory/index.ts smoke",
    "memory:active-soak": "tsx scripts/memory/active-soak.ts",
    "memory:evaluate": "tsx scripts/memory/evaluate.ts",
    "memory:qualify-retrieval": "tsx scripts/memory/qualify-retrieval.ts",
    "memory:qualify-g8": "tsx scripts/memory/qualify-g8.ts",
    "memory:benchmark": "tsx scripts/memory/benchmark.ts",
    "memory:capture-brain-usage": "tsx --env-file-if-exists=.env --env-file-if-exists=.config --env-file-if-exists=.env.local scripts/memory/capture-brain-usage.ts",
    "memory:baseline": "tsx scripts/memory/baseline.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@google/genai": "2.14.0",
    "@guiiai/logg": "1.2.11",
    "@proj-airi/discord-avatar-protocol": "workspace:^",
    "@proj-airi/memory-domain": "workspace:*",
    "@proj-airi/memory-sqlite": "workspace:*",
    "@proj-airi/server-sdk": "workspace:^",
    "@proj-airi/server-shared": "workspace:^",
    "@snazzah/davey": "0.1.11",
    "discord.js": "14.26.3",
    "libsodium-wrappers": "0.8.3",
    "opusscript": "0.1.1",
    "tsx": "4.21.0",
    "valibot": "1.3.1"
  },
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "devDependencies": {
    "vitest": "4.1.4",
    "typescript": "5.9.3",
    "@types/node": "24.12.2"
  }
}
